{
    "$schema": "vendor/pushinbr/pam-native/resources/pam-native.plugin.schema.json",
    "version": 1,
    "protocol": 1,
    "pamNative": {
        "minimum": "1.46.0",
        "maximumExclusive": "2.0.0"
    },
    "php": {
        "provider": "Pam\\Native\\Media\\MediaPluginProvider"
    },
    "android": {
        "namespace": "dev.pam.media",
        "minSdk": 26,
        "permissions": [
            "android.permission.CAMERA",
            "android.permission.RECORD_AUDIO",
            "android.permission.READ_MEDIA_IMAGES",
            "android.permission.READ_MEDIA_VIDEO",
            "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
            "android.permission.READ_EXTERNAL_STORAGE",
            "android.permission.WRITE_EXTERNAL_STORAGE"
        ],
        "dependencies": [
            "androidx.exifinterface:exifinterface:1.4.2",
            "androidx.camera:camera-camera2:1.6.1",
            "androidx.camera:camera-lifecycle:1.6.1",
            "androidx.camera:camera-view:1.6.1",
            "androidx.camera:camera-video:1.6.1",
            "androidx.media3:media3-common:1.10.1",
            "androidx.media3:media3-effect:1.10.1",
            "androidx.media3:media3-transformer:1.10.1"
        ],
        "sourceDirs": [
            "android/src/main/kotlin"
        ],
        "consumerRules": "android/consumer-rules.pro"
    },
    "ios": {
        "minimumVersion": "15.0",
        "sourceDirs": [
            "ios/Sources"
        ],
        "frameworks": [
            "AVFoundation",
            "CoreGraphics",
            "CoreMedia",
            "CoreVideo",
            "ImageIO",
            "UniformTypeIdentifiers",
            "Photos",
            "UIKit"
        ],
        "usageDescriptions": {
            "NSCameraUsageDescription": "Capture photos and videos.",
            "NSMicrophoneUsageDescription": "Record audio with videos."
        }
    },
    "idl": "pam-native.idl.json",
    "modules": [
        {
            "name": "media",
            "class": "dev.pam.media.MediaModule",
            "iosClass": "MediaModule"
        },
        {
            "name": "media-library",
            "class": "dev.pam.media.MediaLibraryModule",
            "iosClass": "MediaLibraryModule"
        },
        {
            "name": "view-capture",
            "class": "dev.pam.media.ViewCaptureModule",
            "iosClass": "ViewCaptureModule"
        }
    ],
    "views": [
        {
            "name": "media.camera",
            "class": "dev.pam.media.CameraViewFactory",
            "iosClass": "CameraViewFactory"
        }
    ]
}
